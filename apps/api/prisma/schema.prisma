generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  COMPLETED
}

enum GarmentType {
  SHIRT
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String?
  lastName     String?
  isActive     Boolean @default(true)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())

  name        String
  description String?

  garmentType GarmentType   @default(SHIRT)
  status      ProjectStatus @default(DRAFT)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Image {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storedFilename   String
  originalFilename String
  mimeType         String
  size             Int

  analyses ImageAnalysis[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

model ImageAnalysis {
  id String @id @default(cuid())

  imageId String
  image   Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  provider      String
  model         String
  promptVersion String

  status AnalysisStatus

  garmentCategory String?
  garmentType     String?
  primaryColor    String?
  secondaryColor  String?
  pattern         String?
  sleeveType      String?
  collarType      String?
  fit             String?
  closureType     String?
  pocketType      String?
  fabricGuess     String?
  gender          String?
  season          String?
  style           String?

  confidence Float?

  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imageId])
}